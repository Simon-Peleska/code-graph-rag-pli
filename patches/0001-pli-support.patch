new file mode 100644
index 000000000..99f81d085
--- /dev/null
+++ b/codebase_rag/constants/ast_mainframe.py
@@ -0,0 +1,43 @@
+# Node types of the z/OS grammars: tree-sitter-jcl, tree-sitter-hlasm
+# (IMS MFS) and tree-sitter-db2 (github.com/Simon-Peleska/tree-sitter-*).
+
+TS_MF_SOURCE_FILE = "source_file"
+TS_MF_FIELD_NAME = "name"
+
+TS_JCL_JOB_STATEMENT = "job_statement"
+TS_JCL_PROC_STATEMENT = "proc_statement"
+TS_JCL_EXEC_STATEMENT = "exec_statement"
+TS_JCL_INCLUDE_STATEMENT = "include_statement"
+TS_JCL_DATA_LINE = "data_line"
+TS_JCL_PARAMETER = "parameter"
+TS_JCL_FIELD_KEY = "key"
+TS_JCL_FIELD_VALUE = "value"
+
+TS_HLASM_STATEMENT = "statement"
+TS_HLASM_KEYWORD_OPERAND = "keyword_operand"
+TS_HLASM_LIST = "list"
+TS_HLASM_WORD = "word"
+TS_HLASM_FIELD_OPERATION = "operation"
+TS_HLASM_FIELD_KEY = "key"
+TS_HLASM_FIELD_VALUE = "value"
+TS_HLASM_FIELD_OPERANDS = "operands"
+# `COPY MEMBER` pulls a member of the SYSLIB concatenation into the source.
+HLASM_COPY = "COPY"
+# The MFS statements that name something a program or another statement
+# refers to: a format and a message (MOD / MID).
+HLASM_MFS_DEFINITIONS = ("FMT", "MSG")
+
+TS_DB2_CREATE_TABLE = "create_table_statement"
+TS_DB2_CREATE_VIEW = "create_view_statement"
+TS_DB2_CREATE_ALIAS = "create_alias_statement"
+TS_DB2_OBJECT_NAME = "object_name"
+
+TS_PLI_STRING_LITERAL = "string_literal"
+
+JCL_FUNCTION_TYPES = (TS_JCL_JOB_STATEMENT, TS_JCL_PROC_STATEMENT)
+HLASM_FUNCTION_TYPES = (TS_HLASM_STATEMENT,)
+DB2_FUNCTION_TYPES = (TS_DB2_CREATE_TABLE, TS_DB2_CREATE_VIEW, TS_DB2_CREATE_ALIAS)
+MF_MODULE_TYPES = (TS_MF_SOURCE_FILE,)
+MF_SCOPE_TYPES = (TS_MF_SOURCE_FILE,)
+JCL_IMPORT_TYPES = (TS_JCL_INCLUDE_STATEMENT,)
+HLASM_IMPORT_TYPES = (TS_HLASM_STATEMENT,)
