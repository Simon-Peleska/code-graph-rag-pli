diff --git a/codebase_rag/tests/test_mainframe.py b/codebase_rag/tests/test_mainframe.py
new file mode 100644
index 000000000..e7098502c
--- /dev/null
+++ b/codebase_rag/tests/test_mainframe.py
@@ -0,0 +1,212 @@
+# IMS / MVS z/OS repositories: JCL jobs and procedures, IMS MFS screens
+# (HLASM), Db2 DDL and the PL/I programs that tie them together, linked as
+# CALLS between their definitions.
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from codebase_rag.config import settings
+from codebase_rag.parser_loader import load_parsers
+from codebase_rag.tests.conftest import get_node_names, get_relationships, run_updater
+
+JOB = """\
+//ABJOB01 JOB (ACCT),CLASS=A
+//S1      EXEC PGM=ABMAIN01
+//S2      EXEC PGM=DFSRRC00,PARM='BMP,ABBMP001,ABPSB01'
+//S3      EXEC IMSBATCH,MBR=ABDLI001,PSB=X
+//S4      EXEC PROC=MYPROC
+//S5      EXEC ABPRC01
+//S6      EXEC PGM=IKJEFT01
+//SYSTSIN DD *
+  DSN SYSTEM(DB2P)
+  RUN PROGRAM(ABDB2001) PLAN(ABPLAN)
+  END
+/*
+//MYPROC  PROC
+//P1      EXEC PGM=ABMAIN01
+//        PEND
+//        INCLUDE MEMBER=ABINC01
+"""
+
+SCREEN = """\
+CUSTFMT  FMT
+         DEV   TYPE=(3270,2),FEAT=IGNORE
+         DIV   TYPE=INOUT
+         DPAGE CURSOR=((3,20))
+CUSTNO   DFLD  POS=(3,20),LTH=8
+         FMTEND
+CUSTI    MSG   TYPE=INPUT,SOR=(CUSTFMT,IGNORE),NXT=CUSTO
+         SEG
+         MFLD  CUSTNO,LTH=8
+         MSGEND
+CUSTO    MSG   TYPE=OUTPUT,SOR=(CUSTFMT,IGNORE)
+         SEG
+         MFLD  CUSTNO,LTH=8
+         MSGEND
+         END
+"""
+
+DDL = """\
+CREATE TABLE PROD.CUSTOMER (ID INTEGER NOT NULL, NAME CHAR(20));
+CREATE TABLE PROD.ORDERS (ID INTEGER NOT NULL,
+  CUST INTEGER REFERENCES PROD.CUSTOMER);
+CREATE VIEW PROD.CUSTV AS SELECT ID FROM PROD.CUSTOMER;
+"""
+
+PROGRAM = """
+ ABMAIN01: PROC OPTIONS(MAIN);
+   DCL MODNAME CHAR(8) INIT('CUSTO   ');
+   EXEC SQL SELECT NAME INTO :N FROM PROD.CUSTOMER WHERE ID = 1;
+   CALL SHOW;
+ SHOW: PROC;
+   EXEC SQL UPDATE ORDERS SET CUST = 2;
+ END SHOW;
+ END ABMAIN01;
+"""
+
+
+def _project(temp_repo: Path, files: dict[str, str]) -> Path:
+    project = temp_repo / "zos"
+    for name, text in files.items():
+        path = project / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text, encoding="utf-8")
+    return project
+
+
+def _calls(mock_ingestor: MagicMock) -> set[tuple[str, str]]:
+    return {
+        (c.args[0][2], c.args[2][2]) for c in get_relationships(mock_ingestor, "CALLS")
+    }
+
+
+def _run(project: Path, mock_ingestor: MagicMock) -> None:
+    parsers, _ = load_parsers()
+    for language in ("jcl", "hlasm", "db2", "pli"):
+        if language not in parsers:
+            pytest.skip(f"{language} parser not available")
+    run_updater(project, mock_ingestor)
+
+
+@pytest.fixture
+def members(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(settings, "PLI_EXTENSIONLESS_MEMBERS", True)
+
+
+def test_definitions(temp_repo: Path, mock_ingestor: MagicMock) -> None:
+    project = _project(
+        temp_repo,
+        {"jobs/abjob01.jcl": JOB, "mfs/cust.mfs": SCREEN, "ddl/tables.ddl": DDL},
+    )
+    _run(project, mock_ingestor)
+
+    functions = get_node_names(mock_ingestor, "Function")
+    assert {
+        "zos.jobs.abjob01.ABJOB01",
+        "zos.jobs.abjob01.MYPROC",
+        "zos.mfs.cust.CUSTFMT",
+        "zos.mfs.cust.CUSTI",
+        "zos.mfs.cust.CUSTO",
+        "zos.ddl.tables.CUSTOMER",
+        "zos.ddl.tables.ORDERS",
+        "zos.ddl.tables.CUSTV",
+    } <= functions, functions
+    assert "zos.mfs.cust.CUSTNO" not in functions
+
+
+def test_jobs_run_programs_and_procedures(
+    temp_repo: Path, mock_ingestor: MagicMock
+) -> None:
+    program = " {name}: PROC OPTIONS(MAIN);\n END {name};\n"
+    project = _project(
+        temp_repo,
+        {
+            "jobs/abjob01.jcl": JOB,
+            "procs/abprc01.jcl": "//ABPRC01 PROC\n//P1 EXEC PGM=ABMAIN01\n",
+            "procs/abinc01.jcl": "//STEPX EXEC PGM=ABMAIN01\n",
+            **{
+                f"src/{name.lower()}.pli": program.format(name=name)
+                for name in ("ABMAIN01", "ABBMP001", "ABDLI001", "ABDB2001")
+            },
+        },
+    )
+    _run(project, mock_ingestor)
+
+    calls = _calls(mock_ingestor)
+    job = "zos.jobs.abjob01.ABJOB01"
+    assert (job, "zos.src.abmain01.ABMAIN01") in calls
+    assert (job, "zos.src.abbmp001.ABBMP001") in calls
+    assert (job, "zos.src.abdli001.ABDLI001") in calls
+    assert (job, "zos.src.abdb2001.ABDB2001") in calls
+    assert (job, "zos.jobs.abjob01.MYPROC") in calls
+    assert (job, "zos.procs.abprc01.ABPRC01") in calls
+    assert ("zos.jobs.abjob01.MYPROC", "zos.src.abmain01.ABMAIN01") in calls
+    assert ("zos.procs.abprc01.ABPRC01", "zos.src.abmain01.ABMAIN01") in calls
+
+    imports = {
+        (c.args[0][2], c.args[2][2])
+        for c in get_relationships(mock_ingestor, "IMPORTS")
+    }
+    assert ("zos.jobs.abjob01", "zos.procs.abinc01") in imports
+
+
+def test_screens_and_tables(temp_repo: Path, mock_ingestor: MagicMock) -> None:
+    project = _project(
+        temp_repo,
+        {
+            "mfs/cust.mfs": SCREEN,
+            "ddl/tables.ddl": DDL,
+            "src/abmain01.pli": PROGRAM,
+        },
+    )
+    _run(project, mock_ingestor)
+
+    calls = _calls(mock_ingestor)
+    assert ("zos.mfs.cust.CUSTI", "zos.mfs.cust.CUSTFMT") in calls
+    assert ("zos.mfs.cust.CUSTI", "zos.mfs.cust.CUSTO") in calls
+    assert ("zos.ddl.tables.CUSTV", "zos.ddl.tables.CUSTOMER") in calls
+    assert ("zos.ddl.tables.ORDERS", "zos.ddl.tables.CUSTOMER") in calls
+    main = "zos.src.abmain01.ABMAIN01"
+    assert (main, "zos.mfs.cust.CUSTO") in calls
+    assert (main, "zos.ddl.tables.CUSTOMER") in calls
+    assert ("zos.src.abmain01.SHOW", "zos.ddl.tables.ORDERS") in calls
+    assert (main, "zos.src.abmain01.SHOW") in calls
+
+
+def test_extensionless_members_route_by_third_letter(
+    temp_repo: Path, mock_ingestor: MagicMock, members: None
+) -> None:
+    project = _project(
+        temp_repo,
+        {
+            "JCL/ABJ00001": "//ABJ00001 JOB (ACCT)\n//S1 EXEC PGM=ABP00001\n",
+            "MFS/ABF00001": SCREEN,
+            "DDL/ABT00001": DDL,
+            "SRC/ABP00001": PROGRAM.replace("ABMAIN01", "ABP00001"),
+        },
+    )
+    _run(project, mock_ingestor)
+
+    calls = _calls(mock_ingestor)
+    main = "zos.SRC.ABP00001.ABP00001"
+    assert ("zos.JCL.ABJ00001.ABJ00001", main) in calls
+    assert (main, "zos.MFS.ABF00001.CUSTO") in calls
+    assert (main, "zos.DDL.ABT00001.CUSTOMER") in calls
+
+
+def test_assembler_copy_is_an_import(temp_repo: Path, mock_ingestor: MagicMock) -> None:
+    project = _project(
+        temp_repo,
+        {
+            "asm/main.asm": "         COPY  REGS\nLBL      DC    F'1'\n         END\n",
+            "maclib/regs.asm": "R1       EQU   1\n",
+        },
+    )
+    _run(project, mock_ingestor)
+
+    imports = {
+        (c.args[0][2], c.args[2][2])
+        for c in get_relationships(mock_ingestor, "IMPORTS")
+    }
+    assert ("zos.asm.main", "zos.maclib.regs") in imports
diff --git a/codebase_rag/tests/test_pli.py b/codebase_rag/tests/test_pli.py
new file mode 100644
index 000000000..0d2f05938
--- /dev/null
+++ b/codebase_rag/tests/test_pli.py
@@ -0,0 +1,433 @@
+# PL/I: label-named procedures, entries and packages, CALL statements and
+# function references, %INCLUDE / EXEC SQL INCLUDE, fixed-format margins and
+# extensionless z/OS member names.
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from codebase_rag.config import settings
+from codebase_rag.tests.conftest import get_node_names, get_relationships, run_updater
+from codebase_rag.utils.pli_margins import blank_fixed_format_margins
+
+SKIP = "pli"
+
+
+def _project(temp_repo: Path, files: dict[str, str]) -> Path:
+    project = temp_repo / "pli_proj"
+    for name, text in files.items():
+        path = project / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text, encoding="utf-8")
+    return project
+
+
+def _edges(mock_ingestor: MagicMock, rel_type: str) -> set[tuple[str, str]]:
+    return {
+        (c.args[0][2], c.args[2][2]) for c in get_relationships(mock_ingestor, rel_type)
+    }
+
+
+def _targets(mock_ingestor: MagicMock, rel_type: str) -> set[str]:
+    return {target for _, target in _edges(mock_ingestor, rel_type)}
+
+
+def test_procedures_and_entries_are_named_by_label(
+    temp_repo: Path, mock_ingestor: MagicMock
+) -> None:
+    project = _project(
+        temp_repo,
+        {
+            "main.pli": """
+hello: proc options(main);
+  put skip list('hi');
+end hello;
+
+other: procedure(n);
+  dcl n fixed bin(31);
+alt: entry(n);
+end other;
+""",
+        },
+    )
+    run_updater(project, mock_ingestor, skip_if_missing=SKIP)
+
+    functions = get_node_names(mock_ingestor, "Function")
+    assert "pli_proj.main.HELLO" in functions
+    assert "pli_proj.main.OTHER" in functions
+    assert any(qn.endswith(".ALT") for qn in functions), functions
+
+
+def test_package_is_a_class(temp_repo: Path, mock_ingestor: MagicMock) -> None:
+    project = _project(
+        temp_repo,
+        {
+            "pkg.pli": """
+mathpkg: package exports(square);
+  square: proc(x) returns(fixed bin(31));
+    dcl x fixed bin(31);
+    return(x * x);
+  end square;
+end mathpkg;
+""",
+        },
