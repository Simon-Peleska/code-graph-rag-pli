diff --git a/codebase_rag/utils/pli_margins.py b/codebase_rag/utils/pli_margins.py
new file mode 100644
index 000000000..56b5b5bf6
--- /dev/null
+++ b/codebase_rag/utils/pli_margins.py
@@ -0,0 +1,64 @@
+"""Blank the margins of fixed-format PL/I before tree-sitter-pli parses it.
+
+Mainframe PL/I is often fixed-format: column 1 holds a carriage-control
+character and columns 73-80 a sequence number, and the grammar reads both as
+code. Overwriting them with spaces keeps every byte offset, so line and column
+positions in the graph still point into the file on disk.
+"""
+
+_FIXED_LINE_LENGTH = 80
+_SEQUENCE_COLUMN = 72
+_CARRIAGE_CONTROL = frozenset(" 01-+")
+# `*PROCESS` / `%PROCESS` compiler options must start in column 1.
+_PROCESS_DIRECTIVES = ("*PROCESS", "%PROCESS")
+
+
+def blank_fixed_format_margins(source: bytes) -> bytes:
+    lines = source.split(b"\n")
+    texts = [
+        line.removesuffix(b"\r").decode("utf-8", errors="surrogateescape")
+        for line in lines
+    ]
+    code = [text for text in texts if text.strip()]
+    if not code or any(len(text) > _FIXED_LINE_LENGTH for text in texts):
+        return source
+    if not all(_is_process(text) or text[0] in _CARRIAGE_CONTROL for text in code):
+        return source
+
+    numbered = sum(1 for text in code if text[_SEQUENCE_COLUMN:].strip())
+    # Real sequence numbers sit on (nearly) every line.
+    blank_sequence = numbered * 10 >= len(code) * 9
+
+    blanked = [
+        _blank_line(line, text, blank_sequence) for line, text in zip(lines, texts)
+    ]
+    result = b"\n".join(blanked)
+    # Callers check `is source` to learn whether the parsed view differs.
+    return source if result == source else result
+
+
+def _is_process(text: str) -> bool:
+    return text.upper().startswith(_PROCESS_DIRECTIVES)
+
+
+def _blank_line(line: bytes, text: str, blank_sequence: bool) -> bytes:
+    carriage_return = b"\r" if line.endswith(b"\r") else b""
+    first, middle, sequence = (
+        text[:1],
+        text[1:_SEQUENCE_COLUMN],
+        text[_SEQUENCE_COLUMN:],
+    )
+    if not _is_process(text):
+        first = _spaces(first)
+    if blank_sequence:
+        sequence = _spaces(sequence)
+    return _encode(first + middle + sequence) + carriage_return
+
+
+def _spaces(text: str) -> str:
+    # One space per byte, so a multi-byte character keeps its byte width.
+    return " " * len(_encode(text))
+
+
+def _encode(text: str) -> bytes:
+    return text.encode("utf-8", errors="surrogateescape")
