new file mode 100644
index 000000000..8abd3bfe1
--- /dev/null
+++ b/codebase_rag/parsers/pli.py
@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from .. import constants as cs
+from ..language_spec import decode_node_text
+
+if TYPE_CHECKING:
+    from tree_sitter import Node
+
+
+def pli_reference_name(reference: Node) -> str | None:
+    # `A.B(1)` is a reference with identifiers A, B and an argument; a
+    # builtin like SUBSTR(...) has a builtin_name instead and yields None.
+    parts = [
+        decode_node_text(c.text).upper()
+        for c in reference.children
+        if c.type == cs.TS_PLI_IDENTIFIER and c.text
+    ]
+    return cs.SEPARATOR_DOT.join(parts) if parts else None
+
+
+def pli_call_name(call_node: Node) -> str | None:
+    # FETCH loads a separately linked program; it is a dependency like CALL.
+    if call_node.type in (cs.TS_PLI_CALL_STATEMENT, cs.TS_PLI_FETCH_STATEMENT):
+        entry = call_node.child_by_field_name(cs.TS_PLI_FIELD_ENTRY)
+        return pli_reference_name(entry) if entry is not None else None
+    # A parenthesised reference in an expression is a function call or an
+    # array subscript; the grammar can't tell them apart. Hand back the name
+    # either way: only names that resolve to a known procedure become edges.
+    if not any(c.type == cs.TS_PLI_ARGUMENT for c in call_node.children):
+        return None
+    parent = call_node.parent
+    if parent is not None and parent.type == cs.TS_PLI_CALL_STATEMENT:
+        return None
+    if (
+        parent is not None
+        and parent.type == cs.TS_PLI_ASSIGNMENT_STATEMENT
+        and parent.named_children
+        and parent.named_children[0] == call_node
+    ):
+        return None
+    return pli_reference_name(call_node)
