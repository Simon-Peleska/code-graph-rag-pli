diff --git a/codebase_rag/parsers/mainframe.py b/codebase_rag/parsers/mainframe.py
new file mode 100644
index 000000000..ee9164fd3
--- /dev/null
+++ b/codebase_rag/parsers/mainframe.py
@@ -0,0 +1,365 @@
+"""Links between the members of an IMS / MVS z/OS repository.
+
+A job runs programs and procedures, a program reads Db2 tables and sends MFS
+screens, a screen message names its format and the next message. None of this
+is a call a tree-sitter call query sees, so this module finds the references
+by hand and links them as CALLS between the definitions: jobs and procedures
+(JCL), formats and messages (HLASM MFS), tables, views and aliases (Db2 DDL)
+and PL/I procedures.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from loguru import logger
+from tree_sitter import Node, Parser, Query, QueryCursor
+
+from .. import constants as cs
+from ..language_spec import get_language_for_path, mainframe_name, pli_label
+
+if TYPE_CHECKING:
+    from ..types_defs import FunctionRegistryTrieProtocol, LanguageQueries
+    from .import_processor import ImportProcessor
+
+MAINFRAME_LANGUAGES = (
+    cs.SupportedLanguage.JCL,
+    cs.SupportedLanguage.HLASM,
+    cs.SupportedLanguage.DB2,
+)
+
+PROGRAM = "program"
+PROCEDURE = "procedure"
+SCREEN = "screen"
+TABLE = "table"
+
+_MEMBER = re.compile(r"[A-Z@#$][A-Z0-9@#$]{0,7}")
+_RUN_PROGRAM = re.compile(
+    r"\bRUN\s+PROG(?:RAM)?\s*\(\s*([A-Z@#$][A-Z0-9@#$]{0,7})\s*\)", re.IGNORECASE
+)
+# IMS region controller: PARM='BMP,PROGRAM,PSB,...' names the program second.
+_IMS_REGION_CONTROLLER = "DFSRRC00"
+_PLI_QUERY = "(string_literal) @string (exec_statement) @exec"
+
+
+@dataclass(frozen=True, slots=True)
+class Reference:
+    # The caller as qn parts below the module, innermost last; the linker
+    # takes the longest that is registered, or the module.
+    caller: tuple[str, ...]
+    kind: str
+    target: str
+    site: Node
+
+
+def _text(node: Node | None) -> str:
+    if node is None or node.text is None:
+        return ""
+    return node.text.decode("utf-8", errors="replace")
+
+
+def _member(text: str) -> str | None:
+    name = text.strip().strip("'\"").strip().upper()
+    if _MEMBER.fullmatch(name):
+        return name
+    return None
+
+
+# ---- JCL --------------------------------------------------------------------
+
+
+def jcl_parameters(statement: Node) -> list[tuple[str, Node]]:
+    """(KEYWORD, value) per operand of a statement; '' for positional ones."""
+    operands = statement.child_by_field_name("operands")
+    if operands is None:
+        return []
+    parameters = []
+    for parameter in operands.named_children:
+        if parameter.type != cs.TS_JCL_PARAMETER:
+            continue
+        value = parameter.child_by_field_name(cs.TS_JCL_FIELD_VALUE)
+        if value is None:
+            continue
+        key = parameter.child_by_field_name(cs.TS_JCL_FIELD_KEY)
+        parameters.append((_text(key).upper(), value))
+    return parameters
+
+
+def _jcl_references(root: Node) -> list[Reference]:
+    references: list[Reference] = []
+    job: tuple[str, ...] = ()
+    caller: tuple[str, ...] = ()
+    for statement in root.named_children:
+        match statement.type:
+            case cs.TS_JCL_JOB_STATEMENT:
+                name = mainframe_name(statement)
+                job = caller = (name,) if name else ()
+            case cs.TS_JCL_PROC_STATEMENT:
+                name = mainframe_name(statement)
+                caller = (name,) if name else ()
+            case "pend_statement":
+                caller = job
+            case cs.TS_JCL_EXEC_STATEMENT:
+                references.extend(_jcl_exec_references(statement, caller))
+            case cs.TS_JCL_DATA_LINE:
+                # IKJEFT01 with `DSN SYSTEM(..)` / `RUN PROGRAM(X)` in SYSTSIN.
+                for match in _RUN_PROGRAM.finditer(_text(statement)):
+                    references.append(
+                        Reference(caller, PROGRAM, match[1].upper(), statement)
+                    )
+    return references
+
+
+def _jcl_exec_references(statement: Node, caller: tuple[str, ...]) -> list[Reference]:
+    references = []
+    parameters = jcl_parameters(statement)
+    program = None
+    for index, (key, value) in enumerate(parameters):
+        if (index == 0 and key == "") or key == "PROC":
+            if name := _member(_text(value)):
+                references.append(Reference(caller, PROCEDURE, name, statement))
+        elif key in ("PGM", "MBR"):
+            if name := _member(_text(value)):
+                program = name
+                if name != _IMS_REGION_CONTROLLER:
+                    references.append(Reference(caller, PROGRAM, name, statement))
+    if program == _IMS_REGION_CONTROLLER:
+        for key, value in parameters:
+            if key != "PARM":
+                continue
+            fields = _text(value).strip("()'\"").split(",")
+            if len(fields) > 1 and (name := _member(fields[1])):
+                references.append(Reference(caller, PROGRAM, name, statement))
+    return references
+
+
+# ---- HLASM (IMS MFS) --------------------------------------------------------
+
+
+def _first_word(node: Node) -> Node | None:
+    if node.type == cs.TS_HLASM_WORD:
+        return node
+    for child in node.named_children:
+        if (word := _first_word(child)) is not None:
+            return word
+    return None
+
+
+def _hlasm_references(root: Node) -> list[Reference]:
+    # A message names the format it is mapped through (SOR=) and the message
+    # that follows it (NXT=).
+    references = []
+    for statement in root.named_children:
+        if statement.type != cs.TS_HLASM_STATEMENT:
+            continue
+        operation = statement.child_by_field_name(cs.TS_HLASM_FIELD_OPERATION)
+        name = mainframe_name(statement)
+        if name is None or _text(operation).upper() != "MSG":
+            continue
+        operands = statement.child_by_field_name("operands")
+        for operand in operands.named_children if operands is not None else []:
+            if operand.type != cs.TS_HLASM_KEYWORD_OPERAND:
+                continue
+            key = _text(operand.child_by_field_name(cs.TS_HLASM_FIELD_KEY)).upper()
+            value = operand.child_by_field_name(cs.TS_HLASM_FIELD_VALUE)
+            if key not in ("SOR", "NXT") or value is None:
+                continue
+            word = _first_word(value)
+            if word is not None and (target := _member(_text(word))):
+                references.append(Reference((name,), SCREEN, target, operand))
+    return references
+
+
+# ---- Db2 --------------------------------------------------------------------
+
+
+def _db2_table_names(node: Node) -> list[tuple[str, Node]]:
+    # Every object_name in a `table` position (FROM, JOIN, INTO, UPDATE,
+    # REFERENCES, ...) or the `target` of an alias, unqualified.
+    names = []
+    stack = [node]
+    while stack:
+        current = stack.pop()
+        for index, child in enumerate(current.children):
+            field = current.field_name_for_child(index)
+            if child.type == cs.TS_DB2_OBJECT_NAME and field in ("table", "target"):
+                if child.named_children and (name := _text(child.named_children[-1])):
+                    names.append((name.strip('"').upper(), child))
+            elif child.named_child_count:
+                stack.append(child)
+    return names
+
+
+def _db2_references(root: Node) -> list[Reference]:
+    references = []
+    for statement in root.named_children:
+        name = (
+            mainframe_name(statement)
+            if statement.type in cs.DB2_FUNCTION_TYPES
+            else None
+        )
+        caller = (name,) if name else ()
+        for table, site in _db2_table_names(statement):
+            if table != name:
+                references.append(Reference(caller, TABLE, table, site))
+    return references
+
+
+# ---- PL/I -------------------------------------------------------------------
+
+
+def _pli_caller(node: Node) -> tuple[str, ...]:
+    procedure = package = None
+    parent = node.parent
+    while parent is not None:
+        if procedure is None and parent.type in cs.PLI_FUNCTION_TYPES:
+            procedure = pli_label(parent)
+        elif parent.type == cs.TS_PLI_PACKAGE_STATEMENT:
+            package = pli_label(parent)
+        parent = parent.parent
+    return tuple(part for part in (package, procedure) if part)
+
+
+def _pli_references(
+    root: Node, query: Query, db2_parser: Parser | None
+) -> list[Reference]:
+    references = []
+    captures = QueryCursor(query).captures(root)
+    for node in captures.get("string", []):
+        # MFS message and format names are passed as padded literals
+        # ('CUSTO   '); anything else member-like simply won't resolve.
+        if name := _member(_text(node)):
+            references.append(Reference(_pli_caller(node), SCREEN, name, node))
+    for node in captures.get("exec", []):
+        language = node.child_by_field_name("language")
+        if db2_parser is None or _text(language).upper() != "SQL":
+            continue
+        sql = node.text[language.end_byte - node.start_byte :].rstrip(b"; \n")
+        tree = db2_parser.parse(sql + b";")
+        caller = _pli_caller(node)
+        for table, _ in _db2_table_names(tree.root_node):
+            references.append(Reference(caller, TABLE, table, node))
+    return references
+
+
+# ---- linking ----------------------------------------------------------------
+
+Emit = Callable[[str, str, str, str, Node], None]
+
+
+class MainframeLinker:
+    def __init__(
+        self,
+        function_registry: FunctionRegistryTrieProtocol,
+        import_processor: ImportProcessor,
+        module_qn_to_file_path: Mapping[str, Path],
+    ) -> None:
+        self._registry = function_registry
+        self._imports = import_processor
+        self._module_paths = module_qn_to_file_path
+        self._pli_query: Query | None = None
+        self._definitions: dict[cs.SupportedLanguage, dict[str, list[str]]] | None = (
+            None
+        )
+
+    def reset(self) -> None:
+        self._definitions = None
+
+    def link(
+        self,
+        root: Node,
+        language: cs.SupportedLanguage,
+        module_qn: str,
+        queries: Mapping[cs.SupportedLanguage, LanguageQueries],
+        emit: Emit,
+    ) -> None:
+        match language:
+            case cs.SupportedLanguage.JCL:
+                references = _jcl_references(root)
+            case cs.SupportedLanguage.HLASM:
+                references = _hlasm_references(root)
+            case cs.SupportedLanguage.DB2:
+                references = _db2_references(root)
+            case cs.SupportedLanguage.PLI:
+                if self._pli_query is None:
+                    self._pli_query = Query(queries[language]["language"], _PLI_QUERY)
+                db2 = queries.get(cs.SupportedLanguage.DB2)
+                references = _pli_references(
+                    root, self._pli_query, db2["parser"] if db2 else None
+                )
+            case _:
+                return
+        for reference in references:
+            caller_label, caller_qn = self._caller(module_qn, reference.caller)
+            targets = self._targets(module_qn, reference)
+            logger.debug(
+                "mainframe: {} {} {} -> {}",
+                caller_qn,
+                reference.kind,
+                reference.target,
+                targets or "unresolved",
+            )
+            for target_qn in targets:
+                if target_qn == caller_qn:
+                    continue
+                target_label = str(
+                    self._registry.get(target_qn) or cs.NodeLabel.FUNCTION
+                )
+                emit(caller_label, caller_qn, target_label, target_qn, reference.site)
+
+    def _caller(self, module_qn: str, parts: tuple[str, ...]) -> tuple[str, str]:
+        for start in range(len(parts)):
+            qn = cs.SEPARATOR_DOT.join((module_qn, *parts[start:]))
+            if qn in self._registry:
+                return str(self._registry[qn]), qn
+        return cs.NodeLabel.MODULE, module_qn
+
+    def _targets(self, module_qn: str, reference: Reference) -> list[str]:
+        if reference.kind == SCREEN:
+            return self._defined(cs.SupportedLanguage.HLASM).get(reference.target, [])
+        if reference.kind == TABLE:
+            return self._defined(cs.SupportedLanguage.DB2).get(reference.target, [])
+        in_stream = f"{module_qn}{cs.SEPARATOR_DOT}{reference.target}"
+        if reference.kind == PROCEDURE and in_stream in self._registry:
+            return [in_stream]
+        return self._program(module_qn, reference.target)
+
+    def _program(self, module_qn: str, member: str) -> list[str]:
+        # A program or cataloged procedure is a member. Its entry is the
+        # top-level definition named like the member, or else every top-level
+        # definition (PL/I nests procedures flat, so these may include
+        # internal ones).
+        target_module = self._imports.resolve_member(member, module_qn)
+        if target_module is None or target_module == module_qn:
+            return []
+        named = f"{target_module}{cs.SEPARATOR_DOT}{member}"
+        if named in self._registry:
+            return [named]
+        depth = target_module.count(cs.SEPARATOR_DOT) + 1
+        return sorted(
+            qn
+            for qn, _ in self._registry.find_with_prefix(target_module)
+            if qn.count(cs.SEPARATOR_DOT) == depth
+        )
+
+    def _defined(self, language: cs.SupportedLanguage) -> dict[str, list[str]]:
+        # Built once per run from the registry: definition name -> qns, for
+        # the MFS screens and the Db2 tables.
+        if self._definitions is None:
+            self._definitions = {
+                cs.SupportedLanguage.HLASM: {},
+                cs.SupportedLanguage.DB2: {},
+            }
+            for qn in self._registry.keys():
+                module_qn, _, name = qn.rpartition(cs.SEPARATOR_DOT)
+                path = self._module_paths.get(module_qn)
+                if path is None:
+                    continue
+                defined = self._definitions.get(get_language_for_path(path))
+                if defined is not None:
+                    defined.setdefault(name, []).append(qn)
+        return self._definitions[language]
