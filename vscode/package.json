{
  "name": "pli-graph",
  "displayName": "PL/I Graph",
  "description": "PL/I, JCL, IMS MFS and Db2 highlighting, Go to Definition, references and dependency trees from a code graph the extension keeps in sync with your files.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simon-Peleska/pli-graph"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "pli",
    "pl/i",
    "pl1",
    "mainframe",
    "jcl",
    "hlasm",
    "mfs",
    "db2"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "pliGraph.mcp",
        "label": "PL/I Graph"
      }
    ],
    "configurationDefaults": {
      "[pli]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.rulers": [
          1,
          72,
          80
        ],
        "editor.tabSize": 3,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[jcl]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[hlasm]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[db2]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "pli",
        "aliases": [
          "PL/I",
          "PLI",
          "PL1"
        ],
        "extensions": [
          ".pli",
          ".pl1",
          ".pco",
          ".inc"
        ],
        "firstLine": "^[*%][Pp][Rr][Oo][Cc][Ee][Ss][Ss]|\\s+[Dd][Ee][Cc][Ll][Aa][Rr][Ee]|\\s+[Dd][Cc][Ll]|\\s+\\w+: [Pp][Rr][Oo][Cc]",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jcl",
        "aliases": [
          "JCL"
        ],
        "extensions": [
          ".jcl",
          ".cntl"
        ],
        "firstLine": "^//[A-Za-z@#$][A-Za-z0-9@#$]*\\s+JOB\\b",
        "configuration": "./jcl-language-configuration.json"
      },
      {
        "id": "hlasm",
        "aliases": [
          "HLASM",
          "IMS MFS",
          "Assembler"
        ],
        "extensions": [
          ".mfs",
          ".asm",
          ".hlasm",
          ".mlc"
        ],
        "configuration": "./hlasm-language-configuration.json"
      },
      {
        "id": "db2",
        "aliases": [
          "Db2 SQL",
          "Db2 DDL"
        ],
        "extensions": [
          ".ddl",
          ".db2"
        ],
        "configuration": "./db2-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pli",
        "scopeName": "source.pli",
        "path": "./syntaxes/pli.tmLanguage.json"
      },
      {
        "language": "jcl",
        "scopeName": "source.jcl",
        "path": "./syntaxes/jcl.tmLanguage.json"
      },
      {
        "language": "hlasm",
        "scopeName": "source.hlasm",
        "path": "./syntaxes/hlasm.tmLanguage.json"
      },
      {
        "language": "db2",
        "scopeName": "source.db2",
        "path": "./syntaxes/db2.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pliGraph.show",
        "title": "Show Graph",
        "category": "PL/I Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pliGraph.flow",
        "title": "Show Flow Diagram",
        "category": "PL/I Graph",
        "icon": "$(git-merge)"
      },
      {
        "command": "pliGraph.flowOf",
        "title": "Show Flow Diagram of Procedure…",
        "category": "PL/I Graph",
        "icon": "$(search)"
      },
      {
        "command": "pliGraph.dataFlow",
        "title": "Show Data Flow of the Variable",
        "category": "PL/I Graph"
      },
      {
        "command": "pliGraph.dataModel",
        "title": "Show Data Model",
        "category": "PL/I Graph",
        "icon": "$(table)"
      },
      {
        "command": "pliGraph.transactions",
        "title": "Show Transaction Data Use",
        "category": "PL/I Graph",
        "icon": "$(symbol-event)"
      },
      {
        "command": "pliGraph.dataUse",
        "title": "Show Data Use of the Procedure",
        "category": "PL/I Graph",
        "icon": "$(database)"
      },
      {
        "command": "pliGraph.deadCode",
        "title": "Show Dead Code",
        "category": "PL/I Graph",
        "icon": "$(trash)"
      },
      {
        "command": "pliGraph.screenInput",
        "title": "Show Input Rules of the Screen",
        "category": "PL/I Graph",
        "icon": "$(checklist)"
      },
      {
        "command": "pliGraph.columnPath",
        "title": "Show Path of the Column",
        "category": "PL/I Graph",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "pliGraph.showScreen",
        "title": "Show 3270 Screen",
        "category": "PL/I Graph",
        "icon": "$(window)"
      },
      {
        "command": "pliGraph.coverage",
        "title": "Coverage Report",
        "category": "PL/I Graph",
        "icon": "$(checklist)"
      },
      {
        "command": "pliGraph.menu",
        "title": "Menu",
        "category": "PL/I Graph"
      },
      {
        "command": "pliGraph.rebuild",
        "title": "Rebuild Graph",
        "category": "PL/I Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "pliGraph.tab",
        "title": "Indent to the Next PL/I Tab Stop",
        "category": "PL/I Graph"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pliGraphDependencies",
          "name": "PL/I Dependencies",
          "when": "resourceLangId == pli || pliGraph.activeEditorIsPli"
        },
        {
          "id": "pliGraphDependents",
          "name": "PL/I Dependents",
          "when": "resourceLangId == pli || pliGraph.activeEditorIsPli"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "pliGraph.menu",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "pliGraph.showScreen",
          "when": "editorLangId == hlasm",
          "group": "navigation"
        },
        {
          "command": "pliGraph.dataModel",
          "when": "editorLangId == db2",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pliGraph.showScreen",
          "when": "resourceLangId == hlasm"
        },
        {
          "command": "pliGraph.dataModel",
          "when": "resourceLangId == db2"
        }
      ],
      "view/title": [
        {
          "command": "pliGraph.show",
          "when": "view == pliGraphDependencies || view == pliGraphDependents",
          "group": "navigation"
        },
        {
          "command": "pliGraph.flow",
          "when": "view == pliGraphDependencies",
          "group": "navigation"
        },
        {
          "command": "pliGraph.rebuild",
          "when": "view == pliGraphDependencies || view == pliGraphDependents",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PL/I Graph",
      "properties": {
        "pliGraph.extensionlessMembers": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Index files named like z/OS members (`ABMAIN01`, no extension). The member name's third character picks the language: `J` is JCL, `F` is MFS, `T` is Db2, anything else is PL/I."
        },
        "pliGraph.format.keywordCase": {
          "type": "string",
          "enum": ["upper", "lower", "keep"],
          "default": "upper",
          "scope": "resource",
          "markdownDescription": "Case of keywords when formatting: PL/I's (`DCL`, `IF`), SQL's, assembler's and the letters in numbers and strings (`'1'B`, `1E5`). JCL is always upper case."
        },
        "pliGraph.format.identifierCase": {
          "type": "string",
          "enum": ["upper", "lower", "keep"],
          "default": "upper",
          "scope": "resource",
          "markdownDescription": "Case of PL/I names and SQL host variables when formatting."
        },
        "pliGraph.format.abbreviations": {
          "type": "string",
          "enum": ["short", "long", "keep"],
          "default": "short",
          "scope": "resource",
          "markdownDescription": "PL/I keywords when formatting: the Language Reference's abbreviations (`DCL`, `PROC`, `CHAR`, `BIN`, `INIT`, `GOTO`, `CONV`), or written out (`DECLARE`, `PROCEDURE`, ..., `GO TO`, `CONVERSION`)."
        }
      }
    },
    "keybindings": [
      {
        "command": "pliGraph.tab",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == pli && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && !editorTabMovesFocus"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import ./test/plans.js --test \"test/*.test.*\"",
    "package": "npm run check && node build.mjs --minify && node package-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.85.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "0.0.45",
    "@vscode/test-electron": "2.4.1",
    "esbuild": "0.24.2",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "web-tree-sitter": "0.26.11"
  }
}
