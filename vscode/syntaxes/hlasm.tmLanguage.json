{
  "name": "HLASM",
  "scopeName": "source.hlasm",
  "patterns": [
    { "name": "comment.line.hlasm", "match": "^(\\*|\\.\\*).*$" },
    {
      "match": "^([^\\s*][^\\s]*)?\\s+([A-Za-z@#$][A-Za-z0-9@#$_]*)",
      "captures": {
        "1": { "name": "entity.name.function.hlasm" },
        "2": { "name": "keyword.other.operation.hlasm" }
      }
    },
    { "name": "string.quoted.single.hlasm", "match": "\\b[A-Za-z]?'(?:[^']|'')*'" },
    { "name": "variable.other.symbolic.hlasm", "match": "&[A-Za-z@#$][A-Za-z0-9@#$_]*\\.?" },
    { "name": "variable.parameter.hlasm", "match": "\\b[A-Za-z][A-Za-z0-9]*(?==)" },
    { "name": "constant.numeric.hlasm", "match": "\\b[0-9]+\\b" }
  ]
}
