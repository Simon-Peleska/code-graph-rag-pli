{
  "name": "Db2 SQL",
  "scopeName": "source.db2",
  "patterns": [
    { "name": "comment.line.double-dash.db2", "match": "--.*$" },
    { "name": "comment.block.db2", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.single.db2", "begin": "'", "end": "'" },
    { "name": "string.quoted.double.db2", "begin": "\"", "end": "\"" },
    {
      "match": "(?i)\\b(TABLE|VIEW|ALIAS|SYNONYM|INDEX|TABLESPACE|DATABASE|PROCEDURE|FUNCTION|TRIGGER|SEQUENCE)\\s+((?:[A-Za-z0-9_@#$]+\\.)*[A-Za-z0-9_@#$]+)",
      "captures": {
        "1": { "name": "keyword.other.db2" },
        "2": { "name": "entity.name.type.db2" }
      }
    },
    {
      "name": "keyword.other.db2",
      "match": "(?i)\\b(CREATE|ALTER|DROP|COMMENT|LABEL|GRANT|REVOKE|SELECT|INSERT|UPDATE|DELETE|MERGE|INTO|VALUES|SET|FROM|WHERE|GROUP|BY|HAVING|ORDER|UNION|EXCEPT|INTERSECT|ALL|DISTINCT|AS|ON|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|CROSS|WITH|FETCH|FIRST|ROWS|ONLY|PRIMARY|FOREIGN|KEY|REFERENCES|UNIQUE|CHECK|CONSTRAINT|DEFAULT|NOT|NULL|AND|OR|IN|IS|LIKE|BETWEEN|EXISTS|CASE|WHEN|THEN|ELSE|END|ASC|DESC|USING|STOGROUP|BUFFERPOOL|CCSID|EBCDIC|ASCII|UNICODE|EDITPROC|VALIDPROC|AUDIT|DATA|CAPTURE|CHANGES|NONE|CASCADE|RESTRICT|NO|ACTION|PARTITION|ENDING|AT|COMMIT|ROLLBACK|DECLARE|CURSOR|OPEN|CLOSE|INCLUDE|FOR|TO|PUBLIC)\\b"
    },
    {
      "name": "storage.type.db2",
      "match": "(?i)\\b(SMALLINT|INTEGER|INT|BIGINT|DECIMAL|DEC|NUMERIC|REAL|DOUBLE|FLOAT|DECFLOAT|CHAR|CHARACTER|VARCHAR|VARYING|GRAPHIC|VARGRAPHIC|BINARY|VARBINARY|CLOB|BLOB|DBCLOB|DATE|TIME|TIMESTAMP|ROWID|XML)\\b"
    },
    { "name": "constant.numeric.db2", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
  ]
}
