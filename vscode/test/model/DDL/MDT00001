CREATE TABLE PROD.KUNDE (
  KDNR     CHAR(8)       NOT NULL,
  NAME     VARCHAR(40)   NOT NULL,
  FILIALE  INTEGER       REFERENCES PROD.FILIALE,
  PRIMARY KEY (KDNR)
);
CREATE TABLE PROD.KONTO (
  KTONR    INTEGER       NOT NULL PRIMARY KEY,
  KDNR     CHAR(8)       NOT NULL,
  SALDO    DECIMAL(11,2),
  CONSTRAINT KTO_KD FOREIGN KEY (KDNR) REFERENCES PROD.KUNDE (KDNR)
);
CREATE VIEW PROD.KUNDENKONTO AS
  SELECT K.KDNR, K.NAME, T.SALDO
  FROM PROD.KUNDE K, PROD.KONTO T
  WHERE K.KDNR = T.KDNR;
CREATE ALIAS PROD.KTO FOR PROD.KONTO;
