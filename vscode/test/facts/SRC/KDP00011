 /* KDP00011: KUNDE ANLEGEN */
 KDP00011: PROC(IOPCB_PTR) OPTIONS(MAIN);
   DCL IOPCB_PTR POINTER;
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL 1 IOPCB BASED(IOPCB_PTR),
         2 LTERM  CHAR(8),
         2 *      CHAR(2),
         2 STATUS CHAR(2);
   DCL DREI FIXED BIN(31) STATIC INIT(3);
   DCL GU_FUNC   CHAR(4) STATIC INIT('GU  ');
   DCL ISRT_FUNC CHAR(4) STATIC INIT('ISRT');
   DCL 1 EINGABE,
         2 LL       FIXED BIN(31),
         2 ZZ       FIXED BIN(15),
         2 TRANCODE CHAR(8),
         2 KDNR     PIC '(8)9',
         2 TYP      CHAR(1),
         2 LIMIT    PIC '(7)9';
   DCL 1 AUSGABE,
         2 LL       FIXED BIN(31),
         2 ZZ       FIXED BIN(15),
         2 KDNR     CHAR(8),
         2 MELDUNG  CHAR(79);
   DCL KUNDENNR CHAR(8);
   CALL PLITDLI(DREI, GU_FUNC, IOPCB, EINGABE);
   AUSGABE.KDNR = EINGABE.KDNR;
   AUSGABE.MELDUNG = 'KUNDE ANGELEGT';
   IF EINGABE.KDNR = 0 THEN AUSGABE.MELDUNG = 'KD101 KUNDENNR FEHLT';
   ELSE DO;
     KUNDENNR = EINGABE.KDNR;
     CALL PRUEFE_NR(KUNDENNR);
   END;
   SELECT (EINGABE.TYP);
     WHEN ('P', 'G');
     OTHERWISE AUSGABE.MELDUNG = 'KD102 TYP MUSS P ODER G SEIN';
   END;
   IF TYP = 'P' & LIMIT > 5000 THEN AUSGABE.MELDUNG = 'KD103 LIMIT ZU HOCH';
   CALL PLITDLI(DREI, ISRT_FUNC, IOPCB, AUSGABE);
 PRUEFE_NR: PROC(NUMMER);
   DCL NUMMER CHAR(8);
   IF VERIFY(NUMMER, '0123456789') > 0 THEN AUSGABE.MELDUNG = 'KD104 KUNDENNR NICHT NUMERISCH';
 END PRUEFE_NR;
 END KDP00011;
