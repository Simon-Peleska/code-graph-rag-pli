 /* KDP00010: MONATSABSCHLUSS MIT ALTLASTEN */
 KDP00010: PROC OPTIONS(MAIN);
   DCL TESTMODUS BIT(1) STATIC INIT('0'B);
   DCL VERSION CHAR(2) STATIC INIT('V2');
   DCL ALTFELD CHAR(8), I FIXED BIN(31);
   DCL ZAEHLER FIXED BIN(31) INIT(0);
   DCL SUMME FIXED BIN(31) INIT(0);
   DCL 1 PUFFER,
         2 KOPF  CHAR(4),
         2 DATEN CHAR(76);
   ZAEHLER = 1; DO I = 1 TO 3; END;
   IF TESTMODUS THEN CALL TESTDRUCK;
   IF VERSION = 'V1' THEN DO;
     CALL ALTDRUCK;
     SUMME = SUMME + 1;
   END;
   ELSE PUT SKIP LIST(SUMME);
   SELECT (VERSION);
     WHEN ('V0', 'V1') PUT SKIP LIST('ALT');
     WHEN ('V2') PUT SKIP LIST('NEU');
     OTHERWISE;
   END;
   IF 1 = 0 THEN PUT SKIP LIST('NIE');
 TESTDRUCK: PROC;
   CALL HILFE;
 END TESTDRUCK;
 ALTDRUCK: PROC;
   PUT SKIP LIST('ALT');
 END ALTDRUCK;
 HILFE: PROC;
   PUT SKIP LIST('HILFE');
 END HILFE;
 END KDP00010;
