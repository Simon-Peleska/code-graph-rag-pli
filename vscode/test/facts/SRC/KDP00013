 /* KDP00013: SALDO BUCHEN */
 KDP00013: PROC(IOPCB_PTR) OPTIONS(MAIN);
   DCL IOPCB_PTR POINTER;
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL 1 IOPCB BASED(IOPCB_PTR),
         2 LTERM  CHAR(8),
         2 *      CHAR(2),
         2 STATUS CHAR(2);
   DCL DREI FIXED BIN(31) STATIC INIT(3);
   DCL GU_FUNC   CHAR(4) STATIC INIT('GU  ');
   DCL ISRT_FUNC CHAR(4) STATIC INIT('ISRT');
   DCL 1 EINGABE,
         2 LL       FIXED BIN(31),
         2 ZZ       FIXED BIN(15),
         2 TRANCODE CHAR(8),
         2 KDNR     PIC '(8)9',
         2 BETRAG   PIC '(7)9V99';
   DCL 1 AUSGABE,
         2 LL       FIXED BIN(31),
         2 ZZ       FIXED BIN(15),
         2 SALDO    PIC '(9)9V99',
         2 MELDUNG  CHAR(79);
   DCL KD_NR   CHAR(8);
   DCL BUCHUNG FIXED DEC(11,2);
   DCL NEU     FIXED DEC(11,2);
   CALL PLITDLI(DREI, GU_FUNC, IOPCB, EINGABE);
   KD_NR = EINGABE.KDNR;
   BUCHUNG = EINGABE.BETRAG;
   IF BUCHUNG > 0 THEN DO;
     EXEC SQL UPDATE PROD.KUNDE SET SALDO = SALDO + :BUCHUNG WHERE KDNR = :KD_NR;
     EXEC SQL SELECT SALDO INTO :NEU FROM PROD.KUNDE WHERE KDNR = :KD_NR;
     AUSGABE.SALDO = NEU;
     AUSGABE.MELDUNG = 'GEBUCHT';
   END;
   ELSE AUSGABE.MELDUNG = 'KD201 BETRAG FEHLT';
   CALL PLITDLI(DREI, ISRT_FUNC, IOPCB, AUSGABE);
 END KDP00013;
