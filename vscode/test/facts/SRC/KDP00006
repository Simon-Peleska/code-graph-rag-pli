 KDP00006: PROC(KD) RETURNS(FIXED BIN(31));
   DCL 1 KD,
         2 TYP   CHAR(1),
         2 SALDO FIXED DEC(11,2),
         2 LIMIT FIXED DEC(11,2);
   DCL RC FIXED BIN(31) INIT(0);
   DCL MELDUNG CHAR(40);
   DCL I FIXED BIN(31);
   ON ENDFILE(KUNDIN) RC = 8;
   IF KD.TYP = 'G' THEN
     MELDUNG = 'GESCHAEFTSKUNDE';
   ELSE DO;
     IF SALDO > LIMIT & TYP ^= 'P' THEN RC = 4;
     MELDUNG = 'PRIVATKUNDE';
   END;
   SELECT (TYP);
     WHEN ('A', 'B') RC = 1;
     WHEN ('C') DO;
       RC = 2;
       CALL PRUEFEN(KD, RC);
     END;
     OTHERWISE SIGNAL ERROR;
   END;
   DO I = 1 TO 10 WHILE (RC = 0);
     SALDO = SALDO + I * 2;
   END;
   IF SQLCODE = 100 THEN GOTO ENDE;
   IF RC > 4 THEN RETURN(RC);
 ENDE:
   RETURN(0);
 END KDP00006;
