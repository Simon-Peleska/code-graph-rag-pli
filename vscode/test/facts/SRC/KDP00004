 KDP00004: PROC;
   DCL KD_NR CHAR(8);
   DCL 1 KD, 2 NAME CHAR(40), 2 SALDO FIXED DEC(11,2);
   DCL SALDO_IND FIXED BIN(15);
   DCL ANZAHL FIXED BIN(31);
   EXEC SQL SELECT NAME, SALDO INTO :KD.NAME, :KD.SALDO :SALDO_IND
            FROM PROD.KUNDE WHERE KDNR = :KD_NR AND TYP = 'G';
   EXEC SQL SELECT COUNT(*) INTO :ANZAHL FROM PROD.KUNDE;
   EXEC SQL UPDATE PROD.KUNDE SET SALDO = SALDO + :KD.SALDO
            WHERE KDNR = :KD_NR;
   EXEC SQL INSERT INTO PROD.BUCHUNG (BUCHNR, KDNR, BETRAG)
            VALUES (NEXT VALUE FOR BUCHSEQ, :KD_NR, :KD.SALDO);
   EXEC SQL DECLARE C1 CURSOR FOR
            SELECT B.BUCHNR, B.BETRAG FROM PROD.BUCHUNG B, PROD.KUNDE K
            WHERE B.KDNR = K.KDNR AND K.TYP = 'G' ORDER BY B.BUCHNR;
   EXEC SQL OPEN C1;
   EXEC SQL FETCH C1 INTO :ANZAHL, :KD.SALDO;
   EXEC SQL CLOSE C1;
 END KDP00004;
