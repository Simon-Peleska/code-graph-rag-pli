 /* KDP00016: KUNDENTYP EINSTUFEN */
 KDP00016: PROC(IOPCB_PTR) OPTIONS(MAIN);
   %INCLUDE KDC00001;
   DCL IOPCB_PTR POINTER;
   DCL KUNDE_PTR POINTER;
   DCL STUFE FIXED BIN(31) INIT(0);
   SELECT (KDTYP);
     WHEN ('G') STUFE = 4;
     WHEN ('P', 'X') STUFE = 0;
     OTHERWISE STUFE = 8;
   END;
 END KDP00016;
