 KDP00001: PROC(IOPCB_PTR, DBPCB_PTR) OPTIONS(MAIN);
   %INCLUDE KDC00001;
   DCL (IOPCB_PTR, DBPCB_PTR) POINTER;
   DCL KUNDE_PTR POINTER;
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL GU_FUNC   CHAR(4) STATIC INIT('GU  ');
   DCL MAX_KREDIT FIXED DEC(11,2) VALUE(50000);
   DCL 1 KUNDE_SSA STATIC,
         2 SEGNAME CHAR(8) INIT('KUNDE   '),
         2 *       CHAR(1) INIT('(');
   DCL K2 LIKE KUNDE_SEG;
   DCL TAGE(12) FIXED BIN(15) INIT(31,28,31,30,31,30,31,31,30,31,30,31);
   CALL PRUEFEN(K2);
 PRUEFEN: PROC(K) RETURNS(BIT(1));
   DCL 1 K LIKE KUNDE_SEG;
   DCL OK BIT(1) INIT('1'B);
   RETURN(OK);
 END PRUEFEN;
 END KDP00001;
