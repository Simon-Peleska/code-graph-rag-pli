 /* KDP00017: MAHNLAUF */
 KDP00017: PROC OPTIONS(MAIN);
   DCL SALDEN FILE RECORD INPUT;
   DCL MAHNUNG FILE RECORD OUTPUT;
   %INCLUDE KDC00004;
   DCL 1 MAHN_SATZ,
         2 KDNR   CHAR(8),
         2 MSTUFE FIXED BIN(15);
   DCL ENDE BIT(1) INIT('0'B);
   ON ENDFILE(SALDEN) ENDE = '1'B;
   OPEN FILE(SALDEN), FILE(MAHNUNG);
   READ FILE(SALDEN) INTO(SALDEN_SATZ);
   DO WHILE(^ENDE);
     IF SALDEN_SATZ.SALDO < 0 THEN DO;
       MAHN_SATZ.KDNR = SALDEN_SATZ.KDNR;
       MAHN_SATZ.MSTUFE = 1;
       WRITE FILE(MAHNUNG) FROM(MAHN_SATZ);
     END;
     READ FILE(SALDEN) INTO(SALDEN_SATZ);
   END;
   CLOSE FILE(SALDEN), FILE(MAHNUNG);
 END KDP00017;
