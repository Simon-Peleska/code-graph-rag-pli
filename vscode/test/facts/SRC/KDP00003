 KDP00003: PROC;
   DCL KUNDEN FILE RECORD UPDATE KEYED;
   DCL AUSG FILE RECORD OUTPUT BUFFERED;
   DCL 1 K, 2 KDNR CHAR(8);
   DCL 1 A_SATZ BASED(AP), 2 X CHAR(10);
   REWRITE FILE(KUNDEN) FROM(K) KEY(K.KDNR);
   LOCATE A_SATZ FILE(AUSG) SET(AP);
   DELAY (100);
   DELETE FILE(KUNDEN) KEY(K.KDNR);
   UNLOCK FILE(KUNDEN) KEY(K.KDNR);
   FLUSH FILE(AUSG);
   FLUSH FILE(*);
   ON ENDFILE(KUNDEN), KEY(KUNDEN) STOP;
   PUT SKIP LIST('FERTIG');
 END KDP00003;
