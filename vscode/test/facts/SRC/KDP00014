 /* KDP00014: SALDENLISTE */
 KDP00014: PROC OPTIONS(MAIN);
   DCL LISTE FILE RECORD OUTPUT;
   DCL 1 ZEILE,
         2 KDNR  CHAR(8),
         2 SALDO PIC '(9)9V99-';
   DCL KD_NR  CHAR(8);
   DCL BETRAG FIXED DEC(11,2);
   DCL ENDE   BIT(1) INIT('0'B);
   EXEC SQL DECLARE C1 CURSOR FOR SELECT KDNR, SALDO FROM PROD.KUNDE ORDER BY KDNR;
   EXEC SQL OPEN C1;
   OPEN FILE(LISTE);
   DO WHILE (^ENDE);
     EXEC SQL FETCH C1 INTO :KD_NR, :BETRAG;
     IF SQLCODE = 100 THEN ENDE = '1'B;
     ELSE DO;
       ZEILE.KDNR = KD_NR;
       ZEILE.SALDO = BETRAG;
       WRITE FILE(LISTE) FROM(ZEILE);
     END;
   END;
   EXEC SQL CLOSE C1;
   CLOSE FILE(LISTE);
 END KDP00014;
