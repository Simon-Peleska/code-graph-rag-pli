 KDP00005: PROC(IOPCB_PTR, ALTPCB_PTR, DBPCB_PTR) OPTIONS(MAIN);
   DCL (IOPCB_PTR, ALTPCB_PTR, DBPCB_PTR) POINTER;
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL CEETDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL 1 IOPCB BASED(IOPCB_PTR),
         2 LTERM  CHAR(8),
         2 *      CHAR(2),
         2 STATUS CHAR(2);
   DCL 1 ALTPCB BASED(ALTPCB_PTR),
         2 DEST   CHAR(8);
   DCL 1 DBPCB BASED(DBPCB_PTR),
         2 DBDNAME CHAR(8),
         2 SEGLEVEL CHAR(2),
         2 STATUS  CHAR(2);
   DCL GU_FUNC   CHAR(4) STATIC INIT('GU  ');
   DCL GNP_FUNC  CHAR(4) STATIC INIT('GNP ');
   DCL ISRT_FUNC CHAR(4) STATIC INIT('ISRT');
   DCL DREI FIXED BIN(31) STATIC INIT(3);
   DCL VIER FIXED BIN(31) STATIC INIT(4);
   DCL 1 KUNDE_SSA STATIC,
         2 SEGNAME CHAR(8) INIT('KUNDE   '),
         2 *       CHAR(1) INIT('('),
         2 FELD    CHAR(8) INIT('KDNR    '),
         2 OP      CHAR(2) INIT(' ='),
         2 WERT    CHAR(8),
         2 *       CHAR(1) INIT(')');
   DCL KONTO_SSA CHAR(9) STATIC INIT('KONTO    ');
   DCL MODNAME CHAR(8) STATIC INIT('KDF001O ');
   DCL MSG CHAR(80);
   DCL SEG CHAR(120);
   CALL PLITDLI(DREI, GU_FUNC, IOPCB, MSG);
   WERT = SUBSTR(MSG, 1, 8);
   CALL PLITDLI(VIER, GU_FUNC, DBPCB, SEG, KUNDE_SSA);
   CALL PLITDLI(VIER, GNP_FUNC, DBPCB, SEG, KONTO_SSA);
   CALL CEETDLI('REPL', DBPCB, SEG);
   CALL PLITDLI(DREI, ISRT_FUNC, ALTPCB, MSG);
   CALL PLITDLI(VIER, ISRT_FUNC, IOPCB, MSG, MODNAME);
   CALL CEETDLI('DLET', DBPCB, SEG);
   CALL KDP00004;
 END KDP00005;
