 /* KDP00015: KREDITRAHMEN PRUEFEN */
 KDP00015: PROC(IOPCB_PTR) OPTIONS(MAIN);
   %INCLUDE KDC00001;
   %INCLUDE KDC00003;
   DCL IOPCB_PTR POINTER;
   DCL KUNDE_PTR POINTER;
   DCL STUFE FIXED BIN(31) INIT(0);
   DCL MELDUNG CHAR(40);
   IF KDTYP = KDTYP_GEWERBE THEN STUFE = 0;
   ELSE IF KDTYP = KDTYP_PRIVAT THEN DO;
     IF KREDIT > 10000 THEN MELDUNG = 'KD301 KREDIT ZU HOCH';
   END;
   ELSE STUFE = 8;
 END KDP00015;
