 KDDRUCK: PROC OPTIONS(MAIN);
   DCL AUSZUG FILE RECORD INPUT;
   DCL LISTE FILE STREAM OUTPUT PRINT;
   DCL ARCHIV FILE RECORD OUTPUT;
   DCL 1 SATZ, 2 KDNR CHAR(8), 2 BETRAG FIXED DEC(11,2);
   DCL ENDE BIT(1) INIT('0'B);
   ON ENDFILE(AUSZUG) ENDE = '1'B;
   OPEN FILE(AUSZUG), FILE(LISTE), FILE(ARCHIV) TITLE('ARCH');
   READ FILE(AUSZUG) INTO(SATZ);
   DO WHILE(^ENDE);
     PUT FILE(LISTE) EDIT(KDNR, BETRAG) (A(8), X(2), F(13,2));
     WRITE FILE(ARCHIV) FROM(SATZ);
     READ FILE(AUSZUG) INTO(SATZ);
   END;
   CLOSE FILE(AUSZUG), FILE(LISTE), FILE(ARCHIV);
 END KDDRUCK;
