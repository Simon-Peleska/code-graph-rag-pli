 KDP00007: PROC(IOPCB_PTR) OPTIONS(MAIN);
   %INCLUDE KDC00001;
   DCL IOPCB_PTR POINTER;
   DCL KUNDE_PTR POINTER;
   DCL 1 MSG,
         2 KDNR  CHAR(8),
         2 TEXT  CHAR(40);
   DCL 1 ALT LIKE KUNDE_SEG;
   DCL BETRAG FIXED DEC(11,2);
   DCL TYP CHAR(1);
   MSG.KDNR = KUNDE_SEG.KDNR;
   ORT = 'BERLIN';
   KUNDE_SEG.PLZ = '10115';
   ALT.KREDIT = KREDIT;
   TYP = KDTYP;
   CALL BUCHEN(MSG.KDNR, KREDIT);
   CALL EXTERN(TYP, BETRAG);
 BUCHEN: PROC(NR, BETRAG);
   DCL NR CHAR(8);
   DCL BETRAG FIXED DEC(11,2);
   BETRAG = BETRAG * 2;
   TEXT = NR;
 END BUCHEN;
 END KDP00007;
