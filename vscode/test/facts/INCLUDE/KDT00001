CREATE TABLE PROD.KUNDE (
  KDNR     CHAR(8)       NOT NULL,
  NAME     VARCHAR(40)   NOT NULL,
  SALDO    DECIMAL(11,2),
  TYP      CHAR(1)       NOT NULL WITH DEFAULT,
  PRIMARY KEY (KDNR)
);
CREATE TABLE PROD.BUCHUNG (
  BUCHNR   INTEGER       NOT NULL PRIMARY KEY,
  KDNR     CHAR(8)       NOT NULL,
  BETRAG   DECIMAL(11,2) NOT NULL
);
