 KDMOV: PROC OPTIONS(MAIN);
   DCL EIN CHAR(1);
   DCL ZWI CHAR(1);
   DCL AUS CHAR(1);
   DCL ERG CHAR(1);
   DCL MSG CHAR(40);
   ZWI = EIN;
   IF ZWI = 'A' THEN AUS = PRUEF(ZWI);
   ERG = HOLE();
   IF ERG = 'J' THEN MSG = 'ABGELEHNT';
   ELSE MSG = 'OK';
 PRUEF: PROC(P) RETURNS(CHAR(1));
   DCL P CHAR(1);
   IF P = 'A' THEN RETURN('J');
   RETURN('N');
 END PRUEF;
 HOLE: PROC RETURNS(CHAR(1));
   RETURN(ZWI);
 END HOLE;
 END KDMOV;
