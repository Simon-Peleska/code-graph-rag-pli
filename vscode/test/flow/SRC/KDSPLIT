 KDSPLIT: PROC OPTIONS(MAIN);
   DCL KEY CHAR(8);
   DCL CNT FIXED BIN(31);
   DCL Y FIXED BIN(31);
   IF CNT > 9 THEN Y = 1;
   EXEC SQL SELECT COUNT(*) INTO :CNT FROM PROD.AATB0301 WHERE ID = :KEY;
   IF CNT = 0 THEN Y = CNT + 1;
   IF Y > 5 THEN CALL SPERRE;
   Y = 0;
   IF Y = 7 THEN CALL SPERRE;
   IF KEY = ' ' THEN RETURN;
 SPERRE: PROC;
 END SPERRE;
 END KDSPLIT;
