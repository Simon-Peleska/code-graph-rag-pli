 FLOWMAIN: PROC OPTIONS(MAIN);
   %INCLUDE FLOWDCL;
   CALL STEP1;
   IF RC > 0 THEN
     PUT SKIP LIST('FEHLER');
   ELSE DO;
     CALL STEP2;
   END;
   DO I = 1 TO 10;
     IF K = 'X' THEN LEAVE;
     CALL NOWHERE;
   END;
   SELECT (KZ);
     WHEN ('A') CALL STEP2;
     OTHERWISE RC = 4;
   END;
   STOP;
 END FLOWMAIN;
