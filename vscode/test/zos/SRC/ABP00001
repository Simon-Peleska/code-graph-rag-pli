 ABP00001: PROC OPTIONS(MAIN);
   %INCLUDE ABC00001;
   DCL KEY CHAR(8);
   DCL 1 COPYC LIKE CUST;
   CUST.ID = KEY;
   CITY = 'X';
   COPYC.ADDR.CITY = CUST.ADDR.CITY;
   TOTAL = TOTAL + 1;
   EXEC SQL SELECT NAME INTO :KEY FROM PROD.CUSTOMER WHERE ID = :CUST.ID;
   EXEC SQL UPDATE PROD.ORDERS SET CUST = 1 WHERE ID = 2;
   CALL INNER;
 INNER: PROC;
   DCL KEY FIXED BIN(31);
   KEY = 1;
 END INNER;
 END ABP00001;
