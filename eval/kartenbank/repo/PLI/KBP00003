 /*    - MINDESTZAHLNUG BERECHENN                                     */
 /*    - AUSZUG SCHRIEBEN WENN BEWEGUNG ODER SALDO                    */
 /*    - ZYKLUSFELDER ZURUECKSETZEN                                   */
 /*                                                                   */
 /*  EINGAEB    CTLCARD ACCTFILE CUSTFILE                             */
 /*  AUSGABE    ACCTOUT STMTFILE                                      */
