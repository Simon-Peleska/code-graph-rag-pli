 /*******************************************************************/
 /* KBP00007  LIMITAENDERUNG ONLINE (TRX KB02, FORMAT KBF002)         */
 /*   NEUES KREDITLIMIT PRUEFEN, IN KB.KONTO SCHREIBEN UND IN         */
 /*   KB.LIMIT_HIST PROTOKOLLIEREN.                                   */
 /*   GRUND: G = GENEHMIGT (KREDITABTEILUNG), K = KUNDENWUNSCH,       */
 /*          S = SENKUNG DURCH DIE BANK                               */
 /*                                                                   */
 /* AENDERUNGEN                                                       */
 /*   2003-06-02  WBE  ERSTELT                                        */
 /*   2005-11-08  WBE  HOECHSTLIMIT 25.000                            */
 /*   2008-09-03  ALM  PROTOKOLL IN KB.LIMIT_HIST                      */
 /*   2010-04-19  ALM  ERHOEHUNG UEBER 50% NUR MIT GRUND G             */
 /*   2013-01-07  HKR  BARGELDLIMIT HOECHSTENS 20% DES LIMITS          */
 /*******************************************************************/
 KBP00007: PROC(IOPCB_PTR) OPTIONS(MAIN);
   DCL IOPCB_PTR POINTER;
   DCL PLITDLI ENTRY EXTERNAL OPTIONS(ASM INTER);
   DCL 1 IOPCB BASED(IOPCB_PTR),
         2 LTERM  CHAR(8),
         2 *      CHAR(2),
         2 STATUS CHAR(2);
   DCL DREI      FIXED BIN(31) STATIC INIT(3);
   DCL GU_FUNC   CHAR(4) STATIC INIT('GU  ');
   DCL ISRT_FUNC CHAR(4) STATIC INIT('ISRT');

   DCL 1 EIN,
         2 LL       FIXED BIN(31),
         2 ZZ       FIXED BIN(15),
         2 TRANCODE CHAR(8),
         2 KTONR    CHAR(11),
         2 NEULIM   PIC '(8)9V99',
         2 GRUND    CHAR(1);
   DCL 1 AUS,
         2 LL       FIXED BIN(31),
         2 ZZ       FIXED BIN(15),
         2 KTONR    CHAR(11),
         2 LIMALT   PIC 'ZZ.ZZZ.ZZ9V,99',
         2 LIMNEU   PIC 'ZZ.ZZZ.ZZ9V,99',
         2 BARLIM   PIC 'ZZ.ZZZ.ZZ9V,99',
         2 MELDUNG  CHAR(79);

   DCL HOECHSTLIMIT FIXED DEC(10,2) STATIC INIT(25000.00);
   DCL MAX_ERHOEH   FIXED DEC(3,2)  STATIC INIT(1.50);
   DCL BAR_ANTEIL   FIXED DEC(3,2)  STATIC INIT(0.20);

   /* HOSTVARIABLEN */
   DCL H_NR    CHAR(11);
   DCL H_ST    CHAR(1);
   DCL H_SLD   FIXED DEC(10,2);
   DCL H_KLIM  FIXED DEC(10,2);
   DCL H_BLIM  FIXED DEC(10,2);
   DCL H_NEU   FIXED DEC(10,2);
   DCL H_BNEU  FIXED DEC(10,2);
   DCL H_GRUND CHAR(1);
   DCL H_LTERM CHAR(8);
   DCL SQLC    PIC '-(4)9';

   CALL PLITDLI(DREI, GU_FUNC, IOPCB, EIN);
   AUS.KTONR = EIN.KTONR;
   AUS.MELDUNG = '';

   IF EIN.KTONR = '' THEN DO;
     AUS.MELDUNG = 'KB201 BITTE KONTONUMMER EINGEBEN';
     GOTO SENDEN;
   END;
   IF VERIFY(EIN.GRUND, 'GKS') > 0 THEN DO;
     AUS.MELDUNG = 'KB202 GRUND MUSS G, K ODER S SEIN';
     GOTO SENDEN;
   END;

   H_NR = EIN.KTONR;
   EXEC SQL SELECT KTO_ST, KTO_SLD, KTO_KLIM, KTO_BLIM
              INTO :H_ST, :H_SLD, :H_KLIM, :H_BLIM
              FROM KB.KONTO
             WHERE KTO_NR = :H_NR;
   IF SQLCODE = 100 THEN DO;
     AUS.MELDUNG = 'KB203 KONTO ' || EIN.KTONR || ' NICHT VORHANDEN';
     GOTO SENDEN;
   END;
   IF SQLCODE ^= 0 THEN GOTO DB2FEHLER;

   AUS.LIMALT = H_KLIM;
   AUS.LIMNEU = H_KLIM;
   AUS.BARLIM = H_BLIM;
   H_NEU = EIN.NEULIM;

   IF H_ST ^= 'A' THEN DO;
     AUS.MELDUNG = 'KB204 LIMITAENDERUNG NUR BEI AKTIVEN KONTEN';
     GOTO SENDEN;
   END;
   IF H_NEU = H_KLIM THEN DO;
     AUS.MELDUNG = 'KB205 NEUES LIMIT GLEICH ALTEM LIMIT, KEINE AENDERUNG';
     GOTO SENDEN;
   END;
   IF H_NEU > HOECHSTLIMIT THEN DO;
     AUS.MELDUNG = 'KB206 HOECHSTLIMIT 25.000,00 UEBERSCHRITTEN';
     GOTO SENDEN;
   END;
   IF H_NEU < H_SLD THEN DO;
     AUS.MELDUNG = 'KB207 NEUES LIMIT UNTER DEM AKTUELLEN SALDO';
     GOTO SENDEN;
   END;
   /* 2010-04-19: GROSSE ERHOEHUNGEN NUR NACH GENEHMIGUNG */
   IF H_NEU > H_KLIM * MAX_ERHOEH & EIN.GRUND ^= 'G' THEN DO;
     AUS.MELDUNG = 'KB208 ERHOEHUNG UEBER 50% NUR MIT GRUND G';
     GOTO SENDEN;
   END;
   IF H_NEU < H_KLIM & EIN.GRUND = 'G' THEN DO;
     AUS.MELDUNG = 'KB209 GRUND G NUR FUER ERHOEHUNGEN';
     GOTO SENDEN;
   END;

   /* 2013-01-07: BARGELDLIMIT HOECHSTENS 20% DES KREDITLIMITS, */
   /*             AUF VOLLE 100 ABGERUNDET                      */
   H_BNEU = H_BLIM;
   IF H_BLIM > H_NEU * BAR_ANTEIL THEN
     H_BNEU = TRUNC(H_NEU * BAR_ANTEIL / 100) * 100;

   EXEC SQL UPDATE KB.KONTO
               SET KTO_KLIM = :H_NEU,
                   KTO_BLIM = :H_BNEU
             WHERE KTO_NR = :H_NR;
   IF SQLCODE ^= 0 THEN GOTO DB2FEHLER;

   H_GRUND = EIN.GRUND;
   H_LTERM = IOPCB.LTERM;
   EXEC SQL INSERT INTO KB.LIMIT_HIST
                  (KTO_NR, AEND_DAT, LIM_ALT, LIM_NEU, BLIM_NEU, GRUND, LTERM)
           VALUES (:H_NR, CURRENT DATE, :H_KLIM, :H_NEU, :H_BNEU,
                   :H_GRUND, :H_LTERM);
   IF SQLCODE ^= 0 THEN GOTO DB2FEHLER;

   AUS.LIMNEU = H_NEU;
   AUS.BARLIM = H_BNEU;
   IF H_BNEU ^= H_BLIM THEN
     AUS.MELDUNG = 'KB211 LIMIT GEAENDERT, BARGELDLIMIT ANGEPASST';
   ELSE
     AUS.MELDUNG = 'KB210 LIMIT GEAENDERT';
   GOTO SENDEN;

 DB2FEHLER:
   SQLC = SQLCODE;
   AUS.MELDUNG = 'KB299 DB2-FEHLER SQLCODE ' || SQLC;

 SENDEN:
   CALL PLITDLI(DREI, ISRT_FUNC, IOPCB, AUS);
 END KBP00007;
